# Public Apps Script Web App endpoint used by every ContentLab browser.
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycbxAvh-KXYqytNO7KgCBVCJAT2HAPC6X0MBrb6toUx9-zHOrxdalDkmp6oC1rkhVkyIFVQ/exec

# Supabase Storage for Instant Sub-Second Cover Image Uploads
VITE_SUPABASE_URL=https://jpjsycnbamvxnwmziedh.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase Auth is mandatory after the completed Auth + RLS cutover.
# VITE_SUPABASE_AUTH_ENABLED is retired; false no longer bypasses authentication.

# Server-only Vercel variables: NEVER prefix these with VITE_.
# Add in Vercel Project Settings > Environment Variables, then redeploy.
OPENROUTER_API_KEY=
# Optional provider/model ID with structured-output support.
# Leave blank to use the default model configured in your OpenRouter account.
OPENROUTER_MODEL=
# The server reuses VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY above.
# Alternatively set SUPABASE_URL and SUPABASE_ANON_KEY for the server.
